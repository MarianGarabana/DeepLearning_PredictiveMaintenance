# Base URL for the FastAPI backend.
# Leave unset in local dev — the app defaults to "/api", which the Vite dev
# server proxies to http://localhost:8000 (see vite.config.ts).
# For production (Vercel), set this to the deployed backend, e.g. the HF Space:
# VITE_API_BASE_URL=https://your-space.hf.space
VITE_API_BASE_URL=
